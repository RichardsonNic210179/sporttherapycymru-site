---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import BookBand from '../components/BookBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Picture } from 'astro:assets';
import { images } from '../assets/images.js';
import { business, priceGroups, routes } from '../data/site.js';
---

<BaseLayout
  title="Sports Massage Prices Cardiff | Sports Massage Therapy Cymru"
  description="Simple, all-inclusive sports massage prices in Cardiff: 45 mins £45, 60 mins £55, 90 mins £80, plus deep tissue and deep oscillation sessions. Book online."
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ href: routes.home, label: 'Home' }, { label: 'Prices' }]} />
      <div class="ph-grid">
        <div>
          <p class="kicker">Prices</p>
          <h1>
            Simple, <span class="nw">all-inclusive</span> prices
            <span class="sub">Sports massage in Cardiff from £45</span>
          </h1>
          <p class="lede">Every price includes all treatments. Choose the length that suits you, then book online in one step.</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href={business.booking}>Book now <Arrow /></a>
            <a class="btn btn-line" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
          </div>
          <ul class="ph-facts">
            <li>All treatments included</li>
            <li>45, 60 &amp; 90 min sessions</li>
            <li>Open 7 days</li>
          </ul>
        </div>
        <div class="ph-media">
          <Picture
            src={images.backMassage}
            alt="Nic massaging a client's back in the treatment room"
            formats={['avif', 'webp']}
            widths={[640, 960, 1200]}
            sizes="(max-width: 960px) 100vw, 42vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="sm-h">
    <div class="wrap">
      {
        priceGroups.map((group) => (
          <div class="p-group">
            <h2 id={group.id}>{group.title}</h2>
            <div class="p-rows">
              {group.items.map((price) => (
                <div class="p-row">
                  <h3 class="dur">
                    {price.minutes} mins<span class="vh"> {price.name.toLowerCase()}</span>
                  </h3>
                  <div class="desc">
                    <p>{price.detail || price.summary}</p>
                  </div>
                  <span class="amt">£{price.amount}</span>
                  <a class="btn btn-line btn-sm" href={business.booking}>
                    Book {price.minutes} mins<span class="vh"> {price.name.toLowerCase()}, £{price.amount}</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <div class="help">
        <div>
          <h2 id="help-h">Not sure which to book?</h2>
          <p>Call or send a message and I'll help you pick the right session. I always reply to all queries.</p>
        </div>
        <div class="acts">
          <a class="btn btn-primary" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
          <a class="btn btn-line" href={routes.contact}>Send a message</a>
        </div>
      </div>
    </div>
  </section>

  <BookBand
    heading="Ready when you are"
    text={`Open 7 days in Birchgrove, Cardiff. ${business.hoursLabel.weekday}, ${business.hoursLabel.weekend}.`}
  />
</BaseLayout>
