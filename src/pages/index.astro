---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { images } from '../assets/images.js';
import { bio, business, fromPrice, prices, reviews, routes, treatments } from '../data/site.js';

const homePrices = prices.filter((price) => price.onHomepage);
const ninetyFrom = Math.min(...prices.filter((price) => price.minutes === 90).map((price) => price.amount));

const title = 'Sports massage in Cardiff | Sports Massage Therapy Cymru';
const description =
  'Sports massage in Cardiff for injury recovery and prevention. Book Sports Massage Therapy Cymru in Birchgrove from £45, open 7 days.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-photo">
      <Picture
        src={images.hero}
        alt="Nic stretching a client's hamstring on the treatment table"
        formats={['avif', 'webp']}
        widths={[640, 960, 1400]}
        sizes="(max-width: 640px) 100vw, 62vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="kicker">{business.name} · Cardiff</p>
        <h1>Sports massage Cardiff<span>for injury recovery &amp; prevention</span></h1>
        <p class="lede">
          Treatment for runners, <span class="nw">gym-goers</span>, footballers, rugby players, CrossFitters, Hyroxers and more. I help the people of Cardiff &amp; South Wales move better and recover faster.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={business.booking}>
            Book now
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" />
            </svg>
          </a>
          <a class="btn btn-line" href={routes.treatments}>View treatments</a>
        </div>
      </div>
    </div>
    <div class="hero-tag"><b>Birchgrove, Cardiff</b>Purpose-built treatment room</div>
  </section>

  <section class="stats" aria-label="At a glance">
    <ul class="wrap">
      <li><div class="n">200+<small>reviews</small></div><p>Five-star rated on Google</p></li>
      <li><div class="n">7<small>days</small></div><p>Open every day from 8:30am</p></li>
      <li><div class="n">4<small>therapies</small></div><p>Combined to suit your goals</p></li>
      <li><div class="n">£{fromPrice}</div><p>From, every treatment included</p></li>
    </ul>
  </section>

  <section class="block" id="treatments" aria-labelledby="t-h" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="kicker">Treatments</p>
          <h2 id="t-h">Built for how you train</h2>
        </div>
        <p>Sports massage isn't just for when you're injured. It reduces soreness, speeds up muscle repair and keeps your joints mobile.</p>
      </div>
      <ul class="tiles">
        {
          treatments.map((item) => (
            <li>
              <a class="tile" href={item.href}>
                <div class="ph">
                  <Picture
                    src={images[item.image]}
                    alt=""
                    formats={['avif', 'webp']}
                    widths={[320, 480, 720]}
                    sizes="(max-width: 640px) 42vw, 22vw"
                  />
                  <span class="num">{item.num}</span>
                </div>
                <div class="bd">
                  <h3>{item.title}</h3>
                  <p>{item.card}</p>
                  <span class="go">
                    Explore
                    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block about" id="about" aria-labelledby="a-h">
    <div class="wrap about-grid">
      <div class="about-ph">
        <Picture
          src={images.portrait}
          alt="Nic, the therapist, standing in front of the Sports Massage Therapy Cymru logo wall"
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(max-width: 960px) 100vw, 46vw"
        />
        <div class="badge"><b>Hi, I'm Nic</b><span>Level 4 Massage Therapist</span></div>
      </div>
      <div>
        <p class="kicker">About</p>
        <h2 id="a-h">Recovery starts here</h2>
        <p class="big">{bio[0]}</p>
        <p>{bio[1]}</p>
        <ul class="chips">
          <li>Sport massage</li>
          <li>Dry cupping</li>
          <li>Myofascial release</li>
          <li>Stretching</li>
          <li>Dry needling</li>
        </ul>
        <a class="btn btn-dark" href={routes.about}>About Nic</a>
      </div>
    </div>
  </section>

  <section class="block reviews" id="reviews" aria-labelledby="r-h">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="kicker">Reviews</p>
          <h2 id="r-h">What clients say</h2>
          <p class="g-rating"><span class="star" aria-hidden="true">★</span> Over 200 five-star <span class="nw">Google reviews</span></p>
        </div>
        <div class="rev-actions">
          <a class="btn btn-line" href={routes.reviews}>Read all reviews</a>
          <a class="g-link" href={business.googleProfile} target="_blank" rel="noopener">
            See all on Google<span class="vh"> (opens in a new tab)</span> <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <!-- Reviews are plain crawlable HTML, copied word for word. No Review or AggregateRating schema. -->
      <div class="reviews-grid">
        {
          reviews.map((review) => (
            <figure class="review">
              <div class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</div>
              <blockquote>
                <p>{review.text}</p>
              </blockquote>
              <figcaption>
                <cite>{review.name}</cite>
                <span class="rv-meta">
                  <span class="g-mark" aria-hidden="true">G</span>
                  Google review
                  <span class="rv-dot" aria-hidden="true">·</span>
                  <span class="rv-date">{review.when}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block prices" id="prices" aria-labelledby="p-h">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="kicker">Prices</p>
          <h2 id="p-h">Simple, <span class="nw">all-inclusive</span> prices</h2>
        </div>
        <p>Every price includes all treatments. Choose the length that suits you.</p>
      </div>
      <div class="p-rows">
        {
          homePrices.map((price) => (
            <div class="p-row">
              <span class="dur">{price.minutes} mins</span>
              <div>
                <h3>{price.name}</h3>
                <p>{price.summary}</p>
              </div>
              <span class="amt">£{price.amount}</span>
              <a class="btn btn-line btn-sm" href={business.booking}>
                Book {price.minutes} mins<span class="vh"> {price.name.toLowerCase()}, £{price.amount}</span>
              </a>
            </div>
          ))
        }
      </div>
      <p class="p-note">90-minute sessions from £{ninetyFrom}. <a href={routes.prices}>See all prices</a></p>
    </div>
  </section>

  <section class="block" id="location" aria-labelledby="l-h">
    <div class="wrap loc-grid">
      <div class="loc-card">
        <p class="kicker">Location</p>
        <h2 id="l-h">Birchgrove, Cardiff</h2>
        <address>
          {business.address.street}<br />
          {business.address.locality}, {business.address.city} {business.address.postcode}
        </address>
        <table class="hours">
          <caption class="vh">Opening hours</caption>
          <tr><th scope="row">Monday – Friday</th><td>8:30am – 9:30pm</td></tr>
          <tr><th scope="row">Saturday – Sunday</th><td>8:30am – 6:30pm</td></tr>
        </table>
        <a class="btn btn-line" href={business.directions} target="_blank" rel="noopener">
          Get directions<span class="vh"> (opens in a new tab)</span>
        </a>
      </div>
      <div class="map-col">
        <div class="map">
          <iframe
            title="Map of Sports Massage Therapy Cymru, 33 Groveland Road, Birchgrove, Cardiff CF14 4QX"
            src={business.mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <p class="map-follow">
          <a href={business.googleProfile} target="_blank" rel="noopener">
            Sports Massage Therapy Cymru on Google<span class="vh"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="block contact" id="contact" aria-labelledby="c-h">
    <div class="wrap contact-grid">
      <div>
        <p class="kicker">Contact</p>
        <h2 id="c-h">Questions? Get in touch</h2>
        <p>I always reply to all queries, so please check junk if you're expecting a reply email and don't see one.</p>
        <div class="cl">
          <a href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
          <a class="em" href={`mailto:${business.email}`}>massagetherapycymru@<wbr />gmail.com</a>
        </div>
      </div>
      <ContactForm formName="homepage-contact" />
    </div>
  </section>
</BaseLayout>
