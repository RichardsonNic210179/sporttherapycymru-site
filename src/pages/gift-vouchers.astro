---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Tick from '../components/Tick.astro';
import { business, prices, routes } from '../data/site.js';

const voucherOrder = [
  { minutes: 45, group: 'sports', name: 'sports massage' },
  { minutes: 60, group: 'sports', name: 'sports massage' },
  { minutes: 90, group: 'sports', name: 'sports massage' },
  { minutes: 60, group: 'oscillation', name: 'deep tissue and deep oscillation' },
  { minutes: 90, group: 'oscillation', name: 'deep tissue and deep oscillation' },
];

const vouchers = voucherOrder.map((item) => {
  const price = prices.find((entry) => entry.minutes === item.minutes && entry.group === item.group);
  return `${item.minutes} mins ${item.name}, £${price.amount}`;
});

const faqs = [
  {
    question: 'Who is a gift voucher good for?',
    answer:
      'Anyone who trains, works hard or spends long days at a desk, from runners and gym-goers to people with stiff necks and backs.',
  },
  {
    question: 'How long is a voucher valid?',
    answer: '6 months from the date of purchase.',
  },
  {
    question: 'Which treatments can a voucher be used for?',
    answer: 'Any treatment, including dry needling and dry cupping.',
  },
  {
    question: 'Is the voucher emailed or posted?',
    answer: "It's sent by email.",
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Gift Vouchers in Cardiff | Sports Massage Therapy Cymru"
  description="Sports massage gift vouchers in Cardiff from £45, the perfect Christmas gift for anyone who trains. Valid for 6 months. Contact me to buy one."
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ href: routes.home, label: 'Home' }, { label: 'Gift Vouchers' }]} />
      <h1>Sports Massage Gift Vouchers in Cardiff</h1>
      <p class="lede">
        Give the gift of a sports massage. A voucher from Sports Massage Therapy Cymru is the perfect Christmas gift for anyone who trains, works hard or just needs to unwind.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="p-group">
        <h2>Choose a voucher</h2>
        <ul class="ticks">
          {
            vouchers.map((voucher) => (
              <li>
                <Tick />
                <span>{voucher}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="p-group prose">
        <h2>Want a longer treatment?</h2>
        <p>
          The person receiving the voucher can pay the difference to upgrade. For example, a £55 voucher for 60 minutes becomes a 90-minute massage for an extra £25.
        </p>
      </div>

      <div class="p-group prose">
        <h2>How to buy a voucher</h2>
        <p>
          Get in touch by phone or text on <a href={`tel:${business.phoneTel}`}>07735177801</a>, by email at <a href={`mailto:${business.email}`}>massagetherapycymru@gmail.com</a>, or through the <a href={routes.contact}>contact page</a>.
        </p>
        <a class="btn btn-primary" href={routes.contact}>Contact me</a>
      </div>

      <div class="p-group prose">
        <h2>How to use a voucher</h2>
        <p>The person receiving the voucher contacts me to book their appointment.</p>
      </div>

      <div class="p-group prose">
        <h2>Questions</h2>
        {
          faqs.map((faq) => (
            <>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </>
          ))
        }
      </div>
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

      <div class="p-group prose">
        <h2>Good to know</h2>
        <p>
          Vouchers are valid for 6 months from the date of purchase. Vouchers bought in special offers, such as Black Friday deals, may have different terms, which are shown on the voucher.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
