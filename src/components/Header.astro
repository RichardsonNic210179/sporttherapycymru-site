---
import Brand from './Brand.astro';
import { business, mainNav } from '../data/site.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (href.replace(/\/$/, '') || '/') === path;
---

<div class="util">
  <div class="wrap">
    <span>Open 7 days<span class="hide-s"> · {business.hoursLabel.weekday} · {business.hoursLabel.weekend}</span></span>
    <a href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
  </div>
</div>
<header class="site-header">
  <div class="wrap bar">
    <Brand />
    <nav aria-label="Main">
      <ul class="nav">
        {
          mainNav.map((item) =>
            item.children ? (
              <li>
                <button type="button" data-dd aria-expanded="false" aria-controls="dd-t" aria-haspopup="true">
                  {item.label}
                  <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" />
                  </svg>
                </button>
                <ul class="dd-menu" id="dd-t">
                  {
                    item.children.map((child) => (
                      <li>
                        <a href={child.href}>
                          <b>{child.num}</b>
                          {child.title}
                          <span>{child.menu}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    <a class="btn btn-primary btn-sm" href={business.booking}>Book now</a>
    <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="mnav" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h12" stroke="currentColor" stroke-width="2.2" />
      </svg>
      Menu
    </button>
  </div>
  <nav id="mnav" class="mobile-nav" aria-label="Mobile">
    {
      mainNav.map((item) =>
        item.children ? (
          <>
            <a href={item.href}>{item.label}</a>
            <div class="sub">
              {item.children.map((child) => (
                <a href={child.href}>{child.title}</a>
              ))}
            </div>
          </>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ),
      )
    }
    <a class="btn btn-primary" href={business.booking}>Book now</a>
  </nav>
</header>

<script>
  const dropdowns = document.querySelectorAll('[data-dd]');
  dropdowns.forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      dropdowns.forEach((other) => other.setAttribute('aria-expanded', 'false'));
      button.setAttribute('aria-expanded', String(!open));
    });
  });

  const menuButton = document.querySelector('[data-menu]');
  const setMenu = (open) => {
    if (!menuButton) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    document.body.classList.toggle('menu-open', open);
  };

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll('#mnav a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('.nav')) {
      dropdowns.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    dropdowns.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    if (menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
