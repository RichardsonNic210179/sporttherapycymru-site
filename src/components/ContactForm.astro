---
import { business } from '../data/site.js';

const { formName, showHear = false, showBookButton = true } = Astro.props;
const fieldId = (name) => `${formName}-${name}`;
---

<div class="netlify-form" data-netlify-form-root>
  <div class="book-first">
    <p>
      {
        showBookButton
          ? 'Want to book a sports massage? Click Book now.'
          : 'Want to book a sports massage? Use the Book now button above.'
      }
    </p>
    {showBookButton && <a class="btn btn-primary" href={business.booking}>Book now</a>}
    <p>Got a question? Fill in the form below and I'll be in touch as soon as possible.</p>
  </div>
  <div class="err-summary" data-error-summary role="alert" tabindex="-1">
    <h3>There's a problem</h3>
    <ul></ul>
  </div>
  <div class="send-error" data-send-error role="alert" tabindex="-1">
    <h3>Message not sent</h3>
    <p>Please call or email instead.</p>
    <p><a href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a></p>
    <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
  </div>
  <div class="form-success" data-form-success role="status" tabindex="-1">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="currentColor" stroke-width="2.2"></path>
    </svg>
    <h3 data-thanks>Thanks, your message is sent</h3>
    <p>Want to book now? <a href={business.booking}>Book online with Setmore</a></p>
  </div>
  <form
    name={formName}
    method="POST"
    action="/"
    data-netlify="true"
    netlify-honeypot="website"
    data-netlify-form
    novalidate
  >
    <input type="hidden" name="form-name" value={formName} />
    <div class="field">
      <label for={fieldId('first-name')}>First name <span>(required)</span></label>
      <span class="err-msg" id={`${fieldId('first-name')}-err`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"></circle><path d="M10 5v6M10 13.6v1.4" stroke="#0F1113" stroke-width="2.2"></path></svg>
        <span data-error-text>Enter your first name</span>
      </span>
      <input id={fieldId('first-name')} name="first-name" autocomplete="given-name" required aria-required="true" />
    </div>
    <div class="field">
      <label for={fieldId('last-name')}>Last name <span>(required)</span></label>
      <span class="err-msg" id={`${fieldId('last-name')}-err`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"></circle><path d="M10 5v6M10 13.6v1.4" stroke="#0F1113" stroke-width="2.2"></path></svg>
        <span data-error-text>Enter your last name</span>
      </span>
      <input id={fieldId('last-name')} name="last-name" autocomplete="family-name" required aria-required="true" />
    </div>
    <div class="field full">
      <label for={fieldId('email')}>Email <span>(required)</span></label>
      <span class="err-msg" id={`${fieldId('email')}-err`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"></circle><path d="M10 5v6M10 13.6v1.4" stroke="#0F1113" stroke-width="2.2"></path></svg>
        <span data-error-text>Enter an email address in the right format, like name@example.com</span>
      </span>
      <input id={fieldId('email')} name="email" type="email" autocomplete="email" required aria-required="true" />
    </div>
    <div class="field full">
      <label for={fieldId('message')}>Message <span>(required)</span></label>
      <span class="err-msg" id={`${fieldId('message')}-err`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"></circle><path d="M10 5v6M10 13.6v1.4" stroke="#0F1113" stroke-width="2.2"></path></svg>
        <span data-error-text>Enter your message</span>
      </span>
      <textarea id={fieldId('message')} name="message" required aria-required="true"></textarea>
    </div>
    {
      showHear && (
        <div class="field full">
          <label for={fieldId('hear')}>
            How did you hear about me? <span>(optional)</span>
          </label>
          <span class="hint" id={`${fieldId('hear')}-hint`}>
            For example Google, Instagram or a friend.
          </span>
          <textarea id={fieldId('hear')} name="hear" aria-describedby={`${fieldId('hear')}-hint`} />
        </div>
      )
    }
    <div class="hp" aria-hidden="true">
      <label for={fieldId('website')}>Leave this field empty</label>
      <input id={fieldId('website')} name="website" tabindex="-1" autocomplete="off" />
    </div>
    <button class="btn btn-primary" type="submit">Send message</button>
  </form>
</div>

<script>
  import { bindNetlifyForms } from '../scripts/netlify-form.js';

  bindNetlifyForms();
</script>
