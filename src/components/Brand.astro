---
import { Image } from 'astro:assets';
import { images } from '../assets/images.js';

const { width = 60 } = Astro.props;
const height = Math.round((width * images.logo.height) / images.logo.width);
---

<a class="brand" href="/" aria-label="Sports Massage Therapy Cymru home">
  <Image src={images.logo} alt="" width={width} height={height} densities={[1, 2]} loading="eager" />
  <span class="wm"><span>Sports Massage</span> <span>Therapy <b>Cymru</b></span></span>
</a>
