---
const { width = 60 } = Astro.props;
const height = Math.round((width * 447) / 722);
---

<a class="brand" href="/" aria-label="Sports Massage Therapy Cymru home">
  <img src="/img/mark-rose.png" alt="" width={width} height={height} />
  <span class="wm"><span>Sports Massage</span> <span>Therapy <b>Cymru</b></span></span>
</a>
